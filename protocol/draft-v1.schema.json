{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:specferry:draft:v1",
  "title": "SpecFerry greedy draft request and response",
  "oneOf": [{"$ref": "#/$defs/request"}, {"$ref": "#/$defs/response"}],
  "$defs": {
    "identity": {
      "type": "object",
      "properties": {
        "protocol": {"const": "specferry.draft.v1"},
        "request_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "prefix_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "tokenizer_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "draft_mode": {"const": "greedy"}
      },
      "required": ["protocol", "request_id", "prefix_sha256", "tokenizer_sha256", "draft_mode"]
    },
    "token": {"type": "integer", "minimum": 0, "maximum": 50271},
    "request": {
      "allOf": [{"$ref": "#/$defs/identity"}],
      "properties": {
        "prefix_token_ids": {"type": "array", "minItems": 1, "maxItems": 2048, "items": {"$ref": "#/$defs/token"}},
        "max_draft_tokens": {"type": "integer", "minimum": 0, "maximum": 32}
      },
      "required": ["prefix_token_ids", "max_draft_tokens"],
      "unevaluatedProperties": false
    },
    "response": {
      "allOf": [{"$ref": "#/$defs/identity"}],
      "properties": {
        "draft_token_ids": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/token"}}
      },
      "required": ["draft_token_ids"],
      "description": "Identity must exactly echo the request and token count must not exceed its max_draft_tokens; these cross-message constraints are checked by the native client. Additional response fields are ignored."
    }
  }
}
